{
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "^react$",
    "^react-dom(?:/.*)?$",
    "^next(?:/.*)?$",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/",
    "",
    "^[.]"
  ],
  "importOrderTypeScriptVersion": "6.0.2"
}
