{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "build": "bun run --filter @orbit/web build",
    "check": "bun run --filter @orbit/web typecheck && bun run --filter @orbit/worker typecheck",
    "typecheck": "bun run check",
    "format:check": "prettier --check .",
    "lint": "eslint apps --max-warnings 0",
    "knip": "knip",
    "doctor": "bun scripts/run-react-doctor.mjs",
    "validate": "bun run format:check && bun run typecheck && bun run lint && bun run knip && bun run doctor"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "eslint": "10.14.0",
    "knip": "6.45.0",
    "prettier": "3.9.10",
    "react-doctor": "0.9.22",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.2"
  }
}
