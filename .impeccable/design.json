      "css": ".ds-label{font-family:'IBM Plex Sans Variable',Arial,sans-serif;font-size:.8125rem;font-weight:500;display:block;margin-bottom:8px;color:var(--ink,#171717)}.ds-label span{font-weight:400;color:var(--muted,#666)}.ds-input{font-family:inherit;font-size:.875rem;line-height:1.6;padding:10px 12px;border:1px solid var(--control-border,#888);border-radius:6px;background:var(--surface,#fff);color:var(--ink,#171717)}.ds-control:focus-visible{outline:2px solid var(--focus,#0070f3);outline-offset:3px;}"
    },
    {
      "name": "Task navigation",
      "kind": "nav",
      "refersTo": "workspace-tab",
      "description": "Selected task uses the workspace violet underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button class=\"ds-control\" aria-current=\"page\">Configuration</button><button class=\"ds-control\">Playground</button></nav>",
      "css": ".ds-nav{display:flex;gap:24px;border-bottom:1px solid var(--border,#e5e5e5)}.ds-nav button{font-family:'IBM Plex Sans Variable',Arial,sans-serif;font-size:.8125rem;font-weight:500;padding:12px 2px;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted,#666);cursor:pointer}.ds-nav [aria-current]{color:var(--ink,#171717);border-bottom-color:var(--workspace-accent,#563cc7)}@media(hover:hover) and (pointer:fine){.ds-nav button:hover{color:var(--ink,#171717)}}.ds-control:focus-visible{outline:2px solid var(--focus,#0070f3);outline-offset:3px;}"
