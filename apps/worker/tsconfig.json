{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../web/src/*"],
      "@orbit/migrate": ["../../scripts/migrate.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
