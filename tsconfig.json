{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@orbit/migrate": ["./scripts/migrate.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "playwright*.ts"]
}
