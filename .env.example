DATABASE_URL=postgres://orbit:orbit_dev@localhost:5432/orbit
APP_URL=http://localhost:3000
ORBIT_ADMIN_EMAIL=admin@example.com
ORBIT_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional local development bypass. Start only with bun run dev.
AUTH_DISABLED=false
# Required only when AUTH_DISABLED=true; password credentials can then be omitted.
# AUTH_LOCAL_ADMIN_EMAIL=local-admin@example.test

# Required to save/use per-agent credentials. Generate with: openssl rand -hex 32
# Keep outside PostgreSQL, back up securely, and retain across restarts.
# ORBIT_ENCRYPTION_KEY=

# Optional default OpenRouter key for agents without their own encrypted credential.
# Per-agent keys under Access override this. Set on web and worker. Never exposed to
# the browser or prompts.
# OPENROUTER_API_KEY=
# ORBIT_WORKER_ID=local-worker

# Optional observability. Unset keeps the app and worker offline with no exporter
# network calls. Never commit real keys.
# Sentry: application errors and performance. Set SENTRY_DSN on web and worker.
# Browser capture also needs NEXT_PUBLIC_SENTRY_DSN at web image build time
# (Compose build args / Railway service variables matching the Dockerfile ARGs).
# Runtime env on the running container cannot change the bundled client DSN.
# Source map upload is optional and skipped without SENTRY_AUTH_TOKEN.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Langfuse: agent traces and evaluation scores. Set keys on the worker.
# Prompt/model content is omitted unless LANGFUSE_CAPTURE_CONTENT=true.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_CAPTURE_CONTENT=false

# RustFS / S3-compatible private object storage (agent pictures and knowledge originals).
# Local Compose defaults only; use dedicated credentials in deployment.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orbit
S3_ACCESS_KEY_ID=orbit_local
S3_SECRET_ACCESS_KEY=orbit_local_storage_only

# Optional knowledge embedding model via OpenRouter (AI SDK). Defaults shown.
# Must match the pgvector column width (1536 for text-embedding-3-small).
# KNOWLEDGE_EMBEDDING_MODEL=openai/text-embedding-3-small
# KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# Local/tests only: stub embeddings instead of calling OpenRouter.
# KNOWLEDGE_EMBEDDING_STUB=true

# Optional inbound email. Web receives the domain and signing secret.
# Only the worker receives the Resend API key for inbound retrieval and outbound sends.
# Optional RESEND_SENDING_DOMAIN (worker): when set, From must be a mailbox on that domain.
# RESEND_INBOUND_DOMAIN=
# RESEND_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_SENDING_DOMAIN=

# Optional X API v2 bearer token for recent-search discovery polling (worker).
# Unset means the live adapter is unavailable; polls record status and never crash.
# Fixture adapters are used in tests. Never expose this token to the browser or prompts.
# X_BEARER_TOKEN=
